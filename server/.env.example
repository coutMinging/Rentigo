# ============================================================
# 后端环境变量模板
# 复制一份为 server/.env 后按需修改（.env 已被 .gitignore 忽略，不会入库）
# 也可以不建文件，改用 pm2 / systemd / Docker 直接注入同名变量
# ============================================================

# 运行环境。production 会关闭演示数据、关闭跨域、并启用启动安全自检
NODE_ENV=production

# 后端监听端口（对外只暴露这一个端口即可，前端由后端托管）
PORT=3001

# JWT 签名密钥：生产必填，务必改成随机值
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# 是否写入演示数据。留空时：production 自动为 false，开发自动为 true
# 想在正式库里看演示数据才填 true，否则请保持 false
SEED_DEMO=false

# 空库首次初始化时创建的管理员账号（仅空库生效）
# ADMIN_PASSWORD 留空则自动生成随机密码并打印在启动日志中，请登录后立即修改
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 是否由后端托管前端构建产物。留空 = 自动（存在 web/dist/index.html 就托管）
SERVE_WEB=

# 前端产物目录，默认指向仓库的 web/dist，一般无需修改
WEB_DIST_DIR=

# 允许跨域的前端来源，逗号分隔（如 https://a.example.com,https://b.example.com）
# 单机同源部署请留空：开发环境放开，生产环境关闭
CORS_ORIGINS=

# 租约到期预警提前天数（也可在「系统设置 → 基础参数」里改）
LEASE_WARN_DAYS=30
